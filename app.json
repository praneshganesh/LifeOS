{
  "expo": {
    "name": "Saavi",
    "slug": "life-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saavi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.praneshganesh.lifeos",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Saavi uses on-device speech recognition for Talk.",
        "NSMicrophoneUsageDescription": "Saavi needs the microphone so you can add things by talking.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.praneshganesh.lifeos",
      "adaptiveIcon": {
        "backgroundColor": "#E8ECF1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F4EFE7"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Saavi needs the camera to capture things you own."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Saavi can attach photos of your things and documents."
        }
      ],
      "expo-document-picker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Saavi needs the microphone so you can add things by talking.",
          "speechRecognitionPermission": "Saavi uses on-device speech recognition for Talk.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#5F7350",
          "defaultChannel": "lifeos-reminders"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Saavi uses Face ID to unlock the app."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "cb34adc9-c7a6-46cc-8747-0e0954718262"
      }
    },
    "owner": "praneshganeshs-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cb34adc9-c7a6-46cc-8747-0e0954718262"
    }
  }
}
