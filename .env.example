# OpenAI key: used only by the chat proxy (`npm run chat-api` or Fly). Never put this in the Expo app.
OPENAI_API_KEY=sk-...

# Optional model override (default: gpt-4o-mini. Keep this; gpt-4o is ~15× more expensive)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_PRICE_IN_PER_M=0.15
# OPENAI_PRICE_OUT_PER_M=0.6

# Proxy (local default 8787; Fly/Render set PORT)
# CHAT_API_PORT=8787
# CHAT_API_RPM=30
# CHAT_API_DAILY_MAX=200
# Optional shared proxy token (server + app). App sends X-Saavi-Proxy-Token; Authorization is the Supabase user JWT.
# CHAT_API_TOKEN=
# EXPO_PUBLIC_CHAT_API_TOKEN=

# Chat API (Fly): set these on the server so Talk enforces Supabase AI caps.
# Prefer staging URL + publishable/anon key (same project the app uses).
# SUPABASE_URL=https://<staging-ref>.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...   # or legacy anon JWT
# Optional shared scanner token (app sends as X-Saavi-Proxy-Token; Authorization is the user JWT):
# CHAT_API_TOKEN=
# Browser origins allowed (comma list). Native apps omit Origin and are allowed. Default: all.
# CHAT_API_CORS_ORIGINS=http://localhost:8081

# RevenueCat webhook → Supabase profiles.plan_id (server ONLY, never EXPO_PUBLIC_*).
# RevenueCat dashboard → Integrations → Webhooks: URL https://<chat-api-host>/rc/webhook,
# Authorization header = REVENUECAT_WEBHOOK_SECRET. The proxy calls admin_set_plan_id with the
# service role so Talk / invite caps are enforced from RevenueCat, not from the client.
# REVENUECAT_WEBHOOK_SECRET=<long random string>
# SUPABASE_SERVICE_ROLE_KEY=<service_role key of the same project as SUPABASE_URL>
# Optional: re-read the subscriber from RC REST instead of trusting the event body alone.
# REVENUECAT_SECRET_KEY=sk_...

# App → chat proxy URL
# Web / iOS Simulator:
EXPO_PUBLIC_CHAT_API_URL=http://localhost:8787/chat
# Physical phone on LAN:
# EXPO_PUBLIC_CHAT_API_URL=http://192.168.1.242:8787/chat
# Hosted (after `npm run deploy:chat-api` on Fly):
# EXPO_PUBLIC_CHAT_API_URL=https://saavi-chat-pranesh.fly.dev/chat
# EXPO_PUBLIC_CHAT_API_TOKEN=<same as CHAT_API_TOKEN on Fly>
# Restart Expo after changing EXPO_PUBLIC_* (env is baked at bundler start).
# On web, a LAN chat URL is auto-rewritten to 127.0.0.1 (browsers hang otherwise).

# Supabase: staging branch URL + publishable key (sb_publishable_...). Never a secret / service_role key.
# EXPO_PUBLIC_SUPABASE_URL=https://<staging-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Auth: enable Anonymous + Apple providers; turn on Manual linking so Sign in with Apple
# can linkIdentity onto the anonymous session. See docs/AUTH_APPLE.md (ASC capability + Supabase).

# RevenueCat: public SDK keys only (appl_… / goog_…). Never the secret API key.
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
# Restart Expo after changing EXPO_PUBLIC_* (env is baked at bundler start).
# Purchases require a native build (dev client / TestFlight), not web.
# For TestFlight/EAS: set the same EXPO_PUBLIC_* as EAS secrets/env on the build profile
# (local .env is NOT included in cloud builds).
# In-app trial length in days (default 7). Keep Store intro offers aligned.
# EXPO_PUBLIC_TRIAL_DAYS=7

